---
// Page background: soft gradient glows plus a field of square pixels.
// Short pixel trails run across the field in small stacks, like lines of
// text being written into a book; the last line of each stack is in the
// accent colour, like the line still being written.
---
<div class="bg" aria-hidden="true">
  <canvas data-pixels></canvas>
</div>

<script>
  const cv = document.querySelector<HTMLCanvasElement>('canvas[data-pixels]')!;
  const ctx = cv.getContext('2d')!;
  const grid = document.createElement('canvas');
  const gctx = grid.getContext('2d')!;
  const CELL = 12, DOT = 6, OFF = (CELL - DOT) / 2;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Trail = { row: number; x: number; speed: number; len: number; accent: boolean; delay: number; age: number; end: number };
  let W = 0, H = 0, cols = 0, rows = 0, dpr = 1;
  let colors = { dot: '', ink: '', accent: '' };
  let trails: Trail[] = [];
  let visible = true;

  const smooth = (a: number, b: number, v: number) => { const t = Math.min(1, Math.max(0, (v - a) / (b - a))); return t * t * (3 - 2 * t); };
  // Stronger at the edges and top, quiet behind the text column, gone by the bottom.
  function weight(x: number, y: number) {
    // Phones: the text spans the full width, so keep the field to the band above the title.
    if (W < 720) return 0.6 * (1 - smooth(70, 200, y));
    const protect = Math.min(360, W * 0.26);
    const side = 0.1 + 0.9 * smooth(protect, protect + 240, Math.abs(x - W / 2));
    return side * (1 - smooth(H * 0.35, H * 0.98, y));
  }

  function readColors() {
    const cs = getComputedStyle(document.documentElement);
    colors = { dot: cs.getPropertyValue('--px-dot').trim(), ink: cs.getPropertyValue('--px-ink').trim(), accent: cs.getPropertyValue('--px-accent').trim() };
  }

  function buildGrid() {
    grid.width = cv.width; grid.height = cv.height;
    gctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    gctx.clearRect(0, 0, W, H);
    gctx.fillStyle = colors.dot;
    for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
      const a = weight(c * CELL, r * CELL);
      if (a < 0.03) continue;
      gctx.globalAlpha = a;
      gctx.fillRect(c * CELL + OFF, r * CELL + OFF, DOT, DOT);
    }
    gctx.globalAlpha = 1;
  }

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = cv.clientWidth; H = cv.clientHeight;
    cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    cols = Math.ceil(W / CELL); rows = Math.ceil(H / CELL);
    readColors(); buildGrid();
    if (reduced) drawStatic();
  }

  // One burst = 2-4 trails on rows two apart, each starting a little later and further right.
  function burst() {
    const n = 2 + Math.floor(Math.random() * 3);
    const row = Math.floor(Math.random() * Math.max(1, rows * 0.7 - n * 2));
    const x0 = -Math.floor(Math.random() * cols * 0.2);
    for (let i = 0; i < n; i++) {
      const len = 4 + Math.floor(Math.random() * 10);
      trails.push({ row: row + i * 2, x: x0 + i * 3, speed: 14 + Math.random() * 16, len, accent: i === n - 1, delay: i * 0.35, age: 0, end: cols + len });
    }
  }

  function drawTrail(t: Trail) {
    const head = Math.floor(t.x);
    for (let i = 0; i < t.len; i++) {
      const c = head - i;
      if (c < 0 || c >= cols) continue;
      const x = c * CELL, y = t.row * CELL;
      const a = weight(x, y) * (1 - i / t.len) * (t.accent ? 0.95 : 0.55);
      if (a < 0.02) continue;
      ctx.globalAlpha = a;
      ctx.fillStyle = t.accent ? colors.accent : colors.ink;
      ctx.fillRect(x + OFF, y + OFF, DOT, DOT);
    }
  }

  function drawStatic() {
    ctx.clearRect(0, 0, W, H);
    ctx.drawImage(grid, 0, 0, W, H);
    const rnd = (s: number) => { const v = Math.sin(s * 9301 + 49297) * 233280; return v - Math.floor(v); };
    for (let b = 0; b < 7; b++) {
      const row = Math.floor(rnd(b) * rows * 0.6), x0 = Math.floor(rnd(b + 11) * cols);
      for (let i = 0; i < 3; i++) drawTrail({ row: row + i * 2, x: x0 + i * 3, speed: 0, len: 6 + i * 2, accent: i === 2, delay: 0, age: 0, end: 0 });
    }
    ctx.globalAlpha = 1;
  }

  let last = 0, nextBurst = 0;
  function frame(now: number) {
    requestAnimationFrame(frame);
    if (!visible) { last = now; return; }
    const dt = Math.min(0.05, (now - (last || now)) / 1000);
    last = now;
    if (now > nextBurst && trails.length < 40) { burst(); nextBurst = now + 500 + Math.random() * 900; }
    ctx.clearRect(0, 0, W, H);
    ctx.drawImage(grid, 0, 0, W, H);
    for (const t of trails) {
      t.age += dt;
      if (t.age < t.delay) continue;
      t.x += t.speed * dt;
      drawTrail(t);
    }
    ctx.globalAlpha = 1;
    trails = trails.filter((t) => t.x - t.len < t.end);
  }

  resize();
  addEventListener('resize', () => { clearTimeout((resize as any).t); (resize as any).t = setTimeout(resize, 120); });
  const refresh = () => { readColors(); buildGrid(); if (reduced) drawStatic(); };
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', refresh);
  new MutationObserver(refresh).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  if (!reduced) {
    for (let i = 0; i < 5; i++) { burst(); trails.slice(-4).forEach((t) => { t.x += Math.random() * cols; }); }
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(cv);
    requestAnimationFrame(frame);
  }
</script>

<style>
  .bg {
    position: absolute; inset: 0 0 auto; height: min(1100px, 125vh); z-index: 0; pointer-events: none; overflow: hidden;
    background:
      radial-gradient(55% 60% at 50% -12%, var(--glow-1), transparent 70%),
      radial-gradient(38% 46% at 6% 18%, var(--glow-2), transparent 72%),
      radial-gradient(34% 42% at 96% 26%, var(--glow-3), transparent 72%);
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
</style>
