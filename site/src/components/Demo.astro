---
import { initialState, renderSide, renderList, renderDetail } from '../demo/render';
const st = initialState();
---
<section class="demo-section" id="demo" aria-label="Interactive demo">
  <div class="wrap">
    <div class="window untouched" data-demo>
      <div class="chrome">
        <i></i><i></i><i></i>
        <span>Skillbook</span>
        <input class="search" type="search" placeholder="Search skills" aria-label="Search skills" data-search />
        <em class="badge">Interactive demo · made-up data</em>
      </div>
      <div class="body">
        <aside class="side" data-r="side" set:html={renderSide(st)} />
        <div class="list" data-r="list" set:html={renderList(st)} />
        <div class="detail" data-r="detail" set:html={renderDetail(st)} />
      </div>
      <div class="hint" aria-hidden="true">Try Edit, then break the frontmatter</div>
      <div class="toast" data-toast role="status" aria-live="polite"></div>
    </div>
  </div>
</section>

<script>
  import { SKILLS } from '../demo/data';
  import { initialState, renderSide, renderList, renderDetail, check, statusLabel, visible, type State, type Tab } from '../demo/render';

  const root = document.querySelector<HTMLElement>('[data-demo]')!;
  const st: State = initialState();
  const region = (n: string) => root.querySelector<HTMLElement>(`[data-r="${n}"]`)!;

  function render(parts = ['side', 'list', 'detail']) {
    if (parts.includes('side')) region('side').innerHTML = renderSide(st);
    if (parts.includes('list')) region('list').innerHTML = renderList(st);
    if (parts.includes('detail')) region('detail').innerHTML = renderDetail(st);
  }

  let toastTimer = 0;
  function toast(text: string) {
    const t = root.querySelector<HTMLElement>('[data-toast]')!;
    t.textContent = text;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => t.classList.remove('show'), 2800);
  }

  const current = () => SKILLS.find((s) => s.id === st.sel);

  root.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
    if (!el) return;
    root.classList.remove('untouched');
    const id = el.dataset.id || '';
    const s = current();
    switch (el.dataset.act) {
      case 'row':
        st.sel = id;
        render(['list', 'detail']);
        break;
      case 'tab':
        st.tab = id as Tab;
        render(['detail']);
        break;
      case 'where': {
        st.where = id;
        const list = visible(st);
        if (list.length && !list.some((x) => x.id === st.sel)) st.sel = list[0].id;
        render();
        break;
      }
      case 'copy':
        toast(`Copied “${s?.folder}” to ~/.agents/skills. In the app, pick any user folder or repo.`);
        break;
      case 'move':
        toast(`In the app, Move To puts “${s?.folder}” in another location. Plugin skills ask first.`);
        break;
      case 'reveal':
        toast('In the app, this opens the skill folder in Finder.');
        break;
    }
  });

  // Typing in the editor re-checks the skill live without re-rendering the textarea.
  root.addEventListener('input', (e) => {
    const target = e.target as HTMLElement;
    root.classList.remove('untouched');
    if (target.matches('[data-editor]')) {
      const s = current();
      if (!s) return;
      st.texts[s.id] = (target as HTMLTextAreaElement).value;
      const c = check(s, st.texts[s.id]);
      const status = root.querySelector<HTMLElement>('[data-status]')!;
      status.className = `status ${c.level}`;
      status.innerHTML = statusLabel(c);
      render(['list']);
    } else if (target.matches('[data-search]')) {
      st.q = (target as HTMLInputElement).value;
      const list = visible(st);
      if (list.length && !list.some((x) => x.id === st.sel)) { st.sel = list[0].id; render(['list', 'detail']); }
      else render(['list']);
    }
  });
</script>

<style>
  .demo-section { position: relative; padding: 48px 0 16px; scroll-margin-top: 24px; }
  .demo-section .wrap { position: relative; }
  .demo-section .wrap::before { content: ''; position: absolute; inset: 8% 6% -6%; border-radius: 50%; background: radial-gradient(closest-side, var(--glow-1), transparent); filter: blur(40px); pointer-events: none; }
  .window { position: relative; margin: 0; border-radius: 14px; overflow: hidden; background: var(--mock-bg); color: var(--mock-text); box-shadow: 0 40px 80px -40px rgba(23,23,27,.55), 0 0 0 1px var(--mock-ring); font: 12.5px/1.45 var(--sans); }
  .window :global(button) { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; text-align: left; }
  .chrome { height: 40px; display: flex; align-items: center; gap: 7px; padding: 0 14px; background: var(--mock-side); border-bottom: 1px solid var(--mock-line); }
  .chrome i { width: 11px; height: 11px; border-radius: 50%; background: #3a3a3c; }
  .chrome span { margin-left: 10px; font-size: 12px; font-weight: 600; color: var(--mock-text); }
  .search { margin-left: 16px; width: 190px; background: rgba(255,255,255,.06); border: 1px solid var(--mock-line); border-radius: 7px; padding: 4px 10px; color: var(--mock-text); font: inherit; outline: none; }
  .search:focus { border-color: #8e8e93; }
  .badge { margin-left: auto; font: 500 11px/1 var(--mono); font-style: normal; color: #aeaeb2; border: 1px solid #3a3a3c; border-radius: 999px; padding: 4px 9px; white-space: nowrap; }
  .body { display: grid; grid-template-columns: 196px 300px minmax(0, 1fr); height: 500px; }

  /* icons */
  .window :global(.ico-folder) { width: 16px; height: 13px; flex: none; }
  .window :global(.ico-doc) { width: 14px; height: 17px; flex: none; color: #8e8e93; }
  .window :global(.ico-glyph) { width: 15px; height: 15px; flex: none; color: #aeaeb2; }

  /* sidebar */
  .side { background: var(--mock-side); border-right: 1px solid var(--mock-line); padding: 8px 8px 12px; overflow-y: auto; }
  .side :global(.sec) { margin: 12px 8px 4px; font-size: 11px; font-weight: 600; color: #636366; }
  .side :global(.sec:first-child) { margin-top: 4px; }
  .side :global(.si) { display: flex !important; align-items: center; gap: 8px; width: 100%; padding: 4px 8px !important; border-radius: 6px; color: var(--mock-text); }
  .side :global(.si span) { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .side :global(.si i) { font-style: normal; font-size: 11px; color: var(--mock-muted); font-variant-numeric: tabular-nums; }
  .side :global(.si:hover) { background: #2c2c2e; }
  .side :global(.si.sel) { background: #3a3a3c; }

  /* list */
  .list { overflow-y: auto; border-right: 1px solid var(--mock-line); }
  .list :global(.lh) { position: sticky; top: 0; z-index: 1; display: flex; justify-content: space-between; gap: 8px; padding: 7px 14px 5px; background: var(--mock-bg); border-bottom: 1px solid var(--mock-line); font-size: 11.5px; }
  .list :global(.lh span) { color: #636366; font-size: 10.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .list :global(.row) { display: grid !important; grid-template-columns: 16px minmax(0, 1fr) auto; gap: 10px; align-items: start; width: calc(100% - 12px); margin: 3px 6px; padding: 8px 8px !important; border-radius: 8px; }
  .list :global(.row .ico-doc) { margin-top: 1px; }
  .list :global(.row:hover) { background: #262628; }
  .list :global(.row.sel) { background: #3a3a3c; }
  .list :global(.rt) { min-width: 0; }
  .list :global(.rt b) { display: block; font-weight: 600; }
  .list :global(.rt > span) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: var(--mock-muted); font-size: 11.5px; margin-top: 1px; }
  .list :global(.rt em) { font-style: normal; font-size: 10px; margin-left: 6px; padding: 0 5px; border-radius: 4px; }
  .list :global(.w-warn) { color: #ff9f0a; border: 1px solid rgba(255,159,10,.4); }
  .list :global(.w-bad) { color: #ff6961; border: 1px solid rgba(255,105,97,.4); }
  .list :global(.tool) { display: inline-flex; align-items: center; gap: 5px; font-size: 10.5px; color: var(--mock-muted); white-space: nowrap; }
  .window :global(.tool i), .window :global(.chips i) { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
  .list :global(.none) { padding: 28px 12px; color: var(--mock-muted); text-align: center; }

  /* detail */
  .detail { min-width: 0; display: flex; flex-direction: column; overflow: hidden; }
  .detail :global(.tabs) { display: flex; align-items: center; gap: 2px; padding: 6px 10px; border-bottom: 1px solid var(--mock-line); background: var(--mock-side); flex: none; }
  .detail :global(.tabs > button) { padding: 3px 11px !important; border-radius: 6px; color: var(--mock-muted); }
  .detail :global(.tabs > button:hover) { color: var(--mock-text); }
  .detail :global(.tabs > button.on) { background: #48484a; color: var(--mock-text); }
  .detail :global(.acts) { margin-left: auto; display: flex; gap: 4px; }
  .detail :global(.acts button) { padding: 3px 9px !important; border: 1px solid var(--mock-line) !important; border-radius: 6px; color: var(--mock-muted); white-space: nowrap; }
  .detail :global(.acts button:hover) { color: var(--mock-text); border-color: #636366 !important; }
  .detail :global(.dbody) { flex: 1; overflow: auto; position: relative; }
  .detail :global(.pick) { color: var(--mock-muted); padding: 24px 12px; text-align: center; margin: 0; }

  .detail :global(.pv) { padding: 20px 26px 28px; max-width: 640px; }
  .detail :global(.hd) { display: flex; gap: 12px; align-items: flex-start; }
  .detail :global(.hd .ico-doc) { width: 26px; height: 32px; margin-top: 3px; }
  .detail :global(.hd h3) { margin: 0; font-size: 19px; font-weight: 700; letter-spacing: -.01em; }
  .detail :global(.hd p) { margin: 3px 0 0; color: var(--mock-muted); font-size: 12.5px; line-height: 1.5; }
  .detail :global(.chips) { display: flex; gap: 5px; flex-wrap: wrap; margin: 12px 0 6px; }
  .detail :global(.chips span) { display: inline-flex; align-items: center; gap: 5px; padding: 2px 8px; border-radius: 999px; background: rgba(255,255,255,.07); color: #c7c7cc; font-size: 11px; }
  .detail :global(.path) { font: 11px/1.5 var(--mono); color: #636366; margin-bottom: 14px; overflow-wrap: anywhere; }
  .detail :global(.issues) { display: flex; flex-direction: column; gap: 2px; padding: 9px 11px; border-radius: 8px; margin-bottom: 12px; font-size: 11.5px; color: var(--mock-muted); }
  .detail :global(.issues b) { font-size: 12px; }
  .detail :global(.issues.warn) { background: rgba(255,159,10,.08); border: 1px solid rgba(255,159,10,.22); }
  .detail :global(.issues.warn b) { color: #ff9f0a; }
  .detail :global(.issues.bad) { background: rgba(255,105,97,.08); border: 1px solid rgba(255,105,97,.22); }
  .detail :global(.issues.bad b) { color: #ff6961; }
  .detail :global(dl) { display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; margin: 0 0 14px; padding: 10px 12px; border-radius: 8px; background: rgba(255,255,255,.035); border: 1px solid var(--mock-line); }
  .detail :global(dt) { font: 600 11px/1.6 var(--mono); color: #bf5af2; }
  .detail :global(dd) { margin: 0; color: var(--mock-muted); font-size: 11.5px; }
  .detail :global(.md) { border-top: 1px solid var(--mock-line); padding-top: 4px; font-size: 13px; line-height: 1.6; }
  .detail :global(.md h3) { font-size: 17px; margin: 14px 0 6px; }
  .detail :global(.md h4) { font-size: 14px; margin: 14px 0 4px; }
  .detail :global(.md p) { margin: 6px 0; }
  .detail :global(.md ul), .detail :global(.md ol) { margin: 6px 0; padding-left: 20px; }
  .detail :global(.md li) { margin: 2px 0; }
  .detail :global(.md li::marker) { color: var(--mock-muted); }
  .detail :global(.md code) { font: 11.5px var(--mono); color: #ff7aa2; background: rgba(255,255,255,.07); padding: 1px 4px; border-radius: 4px; }
  .detail :global(.md blockquote) { margin: 8px 0; padding-left: 10px; border-left: 3px solid #636366; color: var(--mock-muted); }
  .detail :global(.md table) { border-collapse: collapse; margin: 8px 0; font-size: 12px; }
  .detail :global(.md th), .detail :global(.md td) { border: 1px solid var(--mock-line); padding: 4px 10px; text-align: left; }
  .detail :global(.md th) { background: rgba(255,255,255,.05); }
  .detail :global(.code) { position: relative; margin: 8px 0; padding: 10px 12px; border-radius: 8px; background: rgba(255,255,255,.04); border: 1px solid var(--mock-line); }
  .detail :global(.code em) { display: block; font: 600 9.5px/1 var(--sans); font-style: normal; letter-spacing: .06em; text-transform: uppercase; color: #636366; margin-bottom: 6px; }
  .detail :global(.code pre) { margin: 0; font: 11.5px/1.55 var(--mono); color: #64d2ff; white-space: pre-wrap; }

  .detail :global(.ed) { position: absolute; inset: 0; }
  .detail :global(textarea) { width: 100%; height: 100%; resize: none; border: 0; outline: none; padding: 18px 22px 52px; background: #141415; color: #e5e5ea; font: 12px/1.7 var(--mono); }
  .detail :global(.status) { position: absolute; right: 12px; bottom: 12px; padding: 4px 10px; border-radius: 999px; background: #2c2c2e; font-size: 11px; font-weight: 500; max-width: calc(100% - 24px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .detail :global(.status.ok) { color: #30d158; }
  .detail :global(.status.warn) { color: #ff9f0a; }
  .detail :global(.status.bad) { color: #ff6961; }

  .detail :global(.files) { padding: 10px; }
  .detail :global(.file) { display: flex; align-items: center; gap: 9px; padding: 6px 8px; border-radius: 6px; }
  .detail :global(.file:hover) { background: #262628; }
  .detail :global(.file span) { flex: 1; font-family: var(--mono); font-size: 12px; }
  .detail :global(.file i) { font-style: normal; color: #636366; font-size: 11px; }

  .hint { position: absolute; right: 24px; top: 92px; background: #f5f5f7; color: #1d1d1f; font-weight: 600; font-size: 12px; padding: 5px 11px; border-radius: 999px; pointer-events: none; opacity: 0; transition: opacity .3s; box-shadow: 0 6px 16px -6px rgba(0,0,0,.6); }
  .untouched .hint { opacity: 1; animation: bob 1.8s ease-in-out infinite; }

  .toast { position: absolute; left: 50%; bottom: 16px; transform: translate(-50%, 12px); background: var(--mock-text); color: var(--mock-bg); padding: 8px 14px; border-radius: 8px; font-weight: 500; opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; max-width: calc(100% - 32px); text-align: center; }
  .toast:empty { display: none; }
  .toast:global(.show) { opacity: 1; transform: translate(-50%, 0); }

  @keyframes bob { 50% { transform: translateY(-4px); } }

  @media (max-width: 1060px) {
    .body { grid-template-columns: 180px minmax(0, 1fr); grid-template-rows: 320px 380px; height: auto; }
    .detail { grid-column: 1 / -1; border-top: 1px solid var(--mock-line); }
    .list { border-right: 0; }
    .detail :global(.acts) { display: none; }
  }
  @media (max-width: 720px) {
    .demo-section { padding-top: 36px; }
    .badge, .hint { display: none; }
    .search { width: auto; flex: 1; min-width: 0; }
    .body { grid-template-columns: 1fr; grid-template-rows: auto 300px 380px; }
    .side { border-right: 0; border-bottom: 1px solid var(--mock-line); display: flex; gap: 4px; overflow-x: auto; padding: 8px; }
    .side :global(.sec) { display: none; }
    .side :global(.si) { width: auto; flex: none; }
  }
</style>
